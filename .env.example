PUBLIC_APP_NAME="Courrier"

WEB_PORT=3100
SERVER_PORT=3101
POSTGRES_PORT=5440

# CORS_ORIGIN="http://localhost:3100"
# PUBLIC_SERVER_URL="http://localhost:3101"
# PUBLIC_APP_URL="http://localhost:3100"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5440/courrier"
# BETTER_AUTH_SECRET="at-least-32-characters-long-random-string"
# BETTER_AUTH_URL="http://localhost:3101"
# TRUST_PROXY="true"
# Minutes between two retention purges (0 turns them off)
# PURGE_INTERVAL_MINUTES=1440
# Server e-mails: the job stays off without the key or the sender address
# BREVO_API_KEY=""
# MAIL_FROM_ADDRESS="courrier@example.com"
# MAIL_FROM_NAME="Courrier"
# Seconds between two drains of the e-mail queue (0 turns them off)
# MAIL_POLL_SECONDS=30

LOG_LEVEL="info"
