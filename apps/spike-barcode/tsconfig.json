{
  "extends": "@repo/typescript-config/react-library.json",
  "include": [
    "src",
    "tests",
    "bench",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "compilerOptions": {
    "paths": {
      "#/*": [
        "./src/*"
      ]
    },
    "types": [
      "node",
      "emscripten",
      "vite/client"
    ],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
