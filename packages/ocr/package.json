{
  "name": "@repo/ocr",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/worker/index.ts",
    "./assets": "./src/assets.ts",
    "./recipient": "./src/recipient.ts",
    "./sender": "./src/sender.ts",
    "./vite": "./src/vite.ts"
  },
  "imports": {
    "#*": [
