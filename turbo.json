{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [".env"],
  "globalEnv": [
    "NODE_ENV",
    "CI",
    "SKIP_ENV_VALIDATION",
    "WEB_PORT",
    "SERVER_PORT",
    "POSTGRES_PORT",
    "CORS_ORIGIN",
    "DATABASE_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "TRUST_PROXY",
    "PUBLIC_APP_NAME",
    "PUBLIC_SERVER_URL",
    "PUBLIC_APP_URL",
    "LOG_LEVEL"
  ],
  "globalPassThroughEnv": ["GITHUB_STEP_SUMMARY"],
  "tasks": {
    "lint": { "dependsOn": ["^lint"] },
    "check-types": { "dependsOn": ["^check-types"] },
    "dev": { "cache": false, "persistent": true },
    "build": { "outputs": ["dist/**"] },
    "test": { "cache": false },
    "build-storybook": { "outputs": ["storybook-static/**"] },
    "db:generate": { "cache": false },
    "db:migrate": { "cache": false },
    "auth:generate": { "cache": false }
  }
}
