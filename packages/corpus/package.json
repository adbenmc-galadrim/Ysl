{
  "name": "@repo/corpus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./schema": "./src/schema.ts",
    "./random": "./src/random.ts",
    "./identities": "./src/synthetic/identities.ts",
    "./manifest": "./src/manifest.ts",
    "./synthetic/barcode": "./src/synthetic/barcode.ts",
    "./synthetic/codes": "./src/synthetic/codes.ts",
    "./synthetic/plan": "./src/synthetic/plan.ts",
    "./src/*": "./src/*"
  },
  "imports": {
    "#*": [
      "./src/*.ts",
      "./src/*/index.ts",
      "./src/*"
    ]
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsx src/cli/check.ts",
    "generate": "tsx src/cli/generate.ts",
    "fetch-web": "tsx src/cli/fetch-web.ts",
    "corpus": "pnpm generate && pnpm fetch-web && pnpm check"
  },
  "dependencies": {
    "@repo/contract": "workspace:*",
    "bwip-js": "^4.11.4",
    "sharp": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
