{
  "name": "@repo/spike-ocr",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "pnpm run assets && vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "tailnet": "tailscale status >/dev/null || { echo 'Tailscale est arrêté : lancer tailscale up' >&2; exit 1; }; tailscale serve --bg 3106",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "build-pack": "tsx scripts/build-pack.ts",
    "assets": "pnpm run build-pack && pnpm run fetch-models",
    "fetch-models": "tsx scripts/fetch-models.ts",
    "bench": "tsx scripts/bench.ts"
  },
  "dependencies": {
    "onnxruntime-web": "1.30.0",
    "ppu-paddle-ocr": "6.6.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@repo/corpus": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "playwright": "1.62.1",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
